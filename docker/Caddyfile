# FrankenPHP behind a TLS-terminating reverse proxy (Traefik).
#
# Vendra is deployed only behind such a proxy, so this server does NO
# certificate management: it speaks plain HTTP on :8080 for every host, and the
# The vendra-controller proxy owns TLS and ports 80/443.
{
	frankenphp
	auto_https off
	# Trust the proxy's forwarded headers so the app sees the real client IP,
	# scheme and Host. Restricted to the private Docker network range.
	servers {
		trusted_proxies static private_ranges
	}
}

# One listener, all hosts. The container healthcheck hits 127.0.0.1:8080/up,
# which this same block serves.
:8080 {
	root * /app/public
	encode zstd br gzip
	php_server
}
