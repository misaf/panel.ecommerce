# Vendra estate configuration. Copy to .env in this directory.
#
# Read by bin/vendra, by every compose file, and distilled into
# platform/platform.env for the application containers. Never commit the filled
# copy: it holds the database and operator credentials.

# ---------------------------------------------------------------------------
# Identity
# ---------------------------------------------------------------------------

# Every platform host derives from this: admin.<base>, console.<base>,
# reseller.<base>, api.<base>, and the per-tenant <slug>.admin.<base> panels.
BASE_DOMAIN=vendra.test

VENDRA_STATE_DIR=/var/lib/vendra
VENDRA_NETWORK=traefik-public

# ---------------------------------------------------------------------------
# Container runtime
# ---------------------------------------------------------------------------

# Docker and Podman both serve the Engine API these stacks and the platform
# speak, so either runs the estate. Rootless Podman is the safer choice: the
# socket the storefront worker mounts is then not root-equivalent on the host.
#
#   Docker             CONTAINER_RUNTIME=docker
#                      CONTAINER_SOCKET=/var/run/docker.sock
#   Podman (rootless)  CONTAINER_RUNTIME=podman
#                      CONTAINER_SOCKET=/run/user/1000/podman/podman.sock
#   Podman (rootful)   CONTAINER_RUNTIME=podman
#                      CONTAINER_SOCKET=/run/podman/podman.sock
#
# Enable the socket first: `systemctl --user enable --now podman.socket`, plus
# `loginctl enable-linger <user>` so it survives logout.
CONTAINER_RUNTIME=docker
CONTAINER_SOCKET=/var/run/docker.sock

# Log driver for storefront containers. json-file and its rotation options are
# Docker's; on Podman use k8s-file, or leave it empty to inherit the runtime's
# own logging configuration.
STOREFRONT_LOG_DRIVER=json-file

# Engine API version. Empty negotiates the default for the runtime named above
# (Docker and Podman's compatibility socket do not accept the same one). Pin it
# only if the runtime rejects that default — a reachable socket refusing the
# version says so by name at provision time.
CONTAINER_API_VERSION=

# ---------------------------------------------------------------------------
# Images
# ---------------------------------------------------------------------------

VENDRA_PLATFORM_IMAGE=ghcr.io/misaf/vendra:1.x
VENDRA_STOREFRONT_IMAGE=ghcr.io/misaf/vendra-storefront-florist@sha256:REPLACE_WITH_DIGEST

# Optional. Unset, the website stack is skipped and the apex host is free.
VENDRA_WEBSITE_IMAGE=

# Use images already in the local daemon instead of pulling. A locally built
# image cannot be pulled, so a `docker compose pull` fails outright on one.
VENDRA_NO_PULL=false

# ---------------------------------------------------------------------------
# TLS
# ---------------------------------------------------------------------------

# Production: set to "letsencrypt" and give ACME a contact address. Traefik then
# obtains and renews every certificate, storefront domains included, over the
# HTTP challenge — so ports 80 and 443 must be reachable from the internet and
# each customer domain must already resolve here.
CERT_RESOLVER=
ACME_EMAIL=

# Local: leave CERT_RESOLVER empty and run `bin/vendra certs`, which issues a
# certificate with mkcert into <state>/certificates. Traefik serves it as the
# default certificate. Re-run it after adding a property so the new domain is
# covered, then `bin/vendra restart`.
#
# Storefronts also make server-side calls to the API. Under mkcert Node rejects
# that certificate and every call fails before it is sent, so point this at the
# mkcert root inside the container to have it mounted and trusted. Leave empty
# under ACME.
STOREFRONT_CA_FILE=

# HSTS max-age. Derived from CERT_RESOLVER when unset — off locally, one year in
# production. Never send it with a certificate the browser does not trust: it
# pins the host to HTTPS and removes the "proceed anyway" bypass.
TRAEFIK_HSTS_SECONDS=

# ---------------------------------------------------------------------------
# Datastores
# ---------------------------------------------------------------------------

DB_DATABASE=vendra
DB_USERNAME=vendra
DB_PASSWORD=
DB_ROOT_PASSWORD=
REDIS_PASSWORD=

# Loopback by default, which covers both ways people reach the database: locally
# from the same machine, and on a server through an SSH tunnel terminating on the
# host. Widening this publishes the database on that interface.
MYSQL_BIND_ADDRESS=127.0.0.1
MYSQL_PORT=3306

# Same reasoning. The Traefik dashboard is unauthenticated.
TRAEFIK_DASHBOARD_BIND_ADDRESS=127.0.0.1
TRAEFIK_DASHBOARD_PORT=8080

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# php artisan key:generate --show
APP_KEY=

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=

# Optional. Seeds the first console operator on a fresh database.
CONSOLE_OPERATOR_USERNAME=
CONSOLE_OPERATOR_EMAIL=
CONSOLE_OPERATOR_PASSWORD=

# Optional storefront settings.
STOREFRONT_STORAGE_BASE_URL=
NESHAN_SERVICE_KEY=
