# Docker/Podman estate configuration. Application settings belong in the root
# .env; never duplicate a key between these two files.

# Estate
BASE_DOMAIN=vendra.test
VENDRA_STATE_DIR=/var/lib/vendra

# Images
VENDRA_PLATFORM_IMAGE=ghcr.io/misaf/vendra:1.x
VENDRA_WEBSITE_IMAGE=
VENDRA_NO_PULL=false

# Runtime mount
#
# Host socket exposed to the storefront worker. Laravel owns the runtime and
# storefront network settings because the application reads them directly.
CONTAINER_SOCKET=/var/run/docker.sock

# Database administration
#
# Database administration and host exposure. Application credentials remain in
# the root .env.
DB_ROOT_PASSWORD=change-this-db-root-password

# Host exposure
MYSQL_BIND_ADDRESS=127.0.0.1
MYSQL_PORT=3306
TRAEFIK_DASHBOARD_BIND_ADDRESS=127.0.0.1
TRAEFIK_DASHBOARD_PORT=8080

# TLS
CERT_RESOLVER=
ACME_EMAIL=
TRAEFIK_HSTS_SECONDS=
