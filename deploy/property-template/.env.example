# /opt/apps/<property>/.env — one file per property. This is the ONLY thing you
# change to onboard a new storefront.
#
# The durable definition of a property (slug, domain, image) lives in
# deploy/properties.yml, which IS committed. This generated file is not — it can
# always be re-rendered with `bin/stack property sync`.

# Public domain the property's storefront is served on.
DOMAIN=example-property.com

# Unique compose/router name (no dots). Usually the property slug.
ROUTER_NAME=example-property

# Platform base domain — must match proxy/.env. Determines the canonical API URL
# the storefront talks to: https://api.${BASE_DOMAIN}
BASE_DOMAIN=vendra.test

# One shared Next.js image used by every storefront.
#
# PIN BY DIGEST in production. A moving tag like :latest means a restart can
# silently ship a different build, and nothing on the host tells you which one is
# actually running:
#   STOREFRONT_IMAGE=ghcr.io/your-org/example-property-storefront@sha256:<digest>
STOREFRONT_IMAGE=ghcr.io/misaf/vendra-storefront-florist@sha256:REPLACE_WITH_DIGEST

# Base64-encoded runtime property JSON. The provisioner writes this value.
STOREFRONT_CONFIG_BASE64=REPLACE_WITH_PROVISIONER_VALUE

# Port the storefront image listens on (Next.js = 3000).
STOREFRONT_PORT=3000

# Path Traefik health-checks before sending traffic to a replica. Override if the
# image exposes a dedicated endpoint (e.g. /api/healthz).
STOREFRONT_HEALTH_PATH=/

# Local dev: empty (mkcert/self-signed). Production: letsencrypt (HTTP-01 — a
# property's DNS belongs to the customer, so the DNS-01 wildcard cannot cover it).
CERT_RESOLVER=
