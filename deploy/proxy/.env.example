# /opt/apps/proxy/.env  — copy to .env and edit.
#
# This file and every other .env on the host are crown-jewel material (see the
# backup section of deploy/README.md). Keep them encrypted at rest — SOPS/age or
# your secrets manager — and never commit a real value.

# Base domain the whole platform hangs off. Local dev: vendra.test
# Production: your real domain, e.g. vendra.com
#
# Required — the platform routers in traefik/dynamic/vendra.yml are rendered
# from it, and Traefik will refuse to start without it.
BASE_DOMAIN=vendra.test

# Certificate resolver selection.
#   CERT_RESOLVER_DNS — the PLATFORM hosts (apex, admin, <slug>.admin, console,
#                       reseller, api, dashboard). One DNS-01 wildcard cert
#                       covers all of them.
#   CERT_RESOLVER     — hosts on CUSTOMER domains, which validate over HTTP-01
#                       because their DNS is not yours: the storefront itself
#                       (set in each property's .env) and admin.<customer-domain>
#                       (routed centrally, so set here too).
#
#   Local dev  : leave BOTH empty → Traefik serves the mkcert/self-signed cert.
#   Production : CERT_RESOLVER_DNS=letsencrypt-dns  and  CERT_RESOLVER=letsencrypt
CERT_RESOLVER_DNS=
CERT_RESOLVER=

# ACME account email is set literally in traefik/traefik.yml (edit it there).

# DNS-01 provider token — needed in production for the platform wildcard.
# Cloudflare example. Scope it to the single zone, least privilege.
CF_DNS_API_TOKEN=
