# /opt/apps/vendra/.env  — overlay values for the Traefik deployment.
# The vendra repo's own .env supplies the rest (DB creds, APP_KEY, mail, …);
# this file only needs what the overlay references.
# Use ./deploy/stack.sh to run the stack — it passes the right -f files and
# --env-file so ${BASE_DOMAIN} interpolates correctly.
#
# Crown-jewel material: keep this encrypted at rest (SOPS/age or your secrets
# manager) and never commit real credentials. See deploy/README.md.

# Must match proxy/.env
BASE_DOMAIN=vendra.test

# Certificate resolvers are selected in the PROXY project now — the platform
# routers moved to proxy/traefik/dynamic/vendra.yml, so nothing here needs them.

# --- Carried through to the app (see vendra repo docker-compose.yml) ---------
APP_KEY=
DB_DATABASE=vendra
DB_USERNAME=vendra
DB_PASSWORD=change-this-db-password
DB_ROOT_PASSWORD=change-this-db-root-password
# MySQL, Redis, Horizon and Mailpit stay on the private network. The overlay
# clears the base compose's 127.0.0.1 port publishing outright — in production
# Traefik is the only container on the host that publishes anything at all.
