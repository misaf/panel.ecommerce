# /opt/apps/vendra/.env  — overlay values for the Traefik deployment.
# The vendra repo's own .env supplies the rest (DB creds, APP_KEY, mail, …);
# this file only needs what the overlay + Traefik labels reference.
# Use ./deploy/stack.sh to run the stack — it passes the right -f files and
# --env-file so ${BASE_DOMAIN} interpolates correctly.

# Must match proxy/.env
BASE_DOMAIN=vendra.test

# Local dev: leave empty (mkcert). Production:
#   CERT_RESOLVER=letsencrypt
#   CERT_RESOLVER_DNS=letsencrypt-dns
CERT_RESOLVER=
CERT_RESOLVER_DNS=

# --- Carried through to the app (see vendra repo docker-compose.yml) ---------
APP_KEY=
DB_DATABASE=vendra
DB_USERNAME=vendra
DB_PASSWORD=change-this-db-password
DB_ROOT_PASSWORD=change-this-db-root-password
# MySQL/Redis/Mailpit stay internal; do NOT publish their ports in production.
# If the base compose publishes 127.0.0.1:3306 etc., that is loopback-only and
# acceptable on a single host; remove entirely for defence in depth.
