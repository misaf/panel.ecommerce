APP_NAME=Vendra
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://localhost
ASSET_URL=https://localhost
TIMEZONE=UTC

SERVER_NAME="console.vendra.test reseller.vendra.test"

CONSOLE_OPERATOR_USERNAME=console
CONSOLE_OPERATOR_EMAIL=console@localhost
CONSOLE_OPERATOR_PASSWORD=change-this-app-console-operator-password

PULSE_INGEST_DRIVER=redis
PULSE_REDIS_CONNECTION=cache

APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_DATABASE=vendra
DB_USERNAME=vendra
DB_PASSWORD=change-this-db-password

REDIS_HOST=127.0.0.1

SESSION_DRIVER=redis
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=null

FILESYSTEM_DISK=public

CACHE_STORE=redis
SETTINGS_CACHE_ENABLED=true
QUEUE_CONNECTION=redis

# Internal authenticated service that deploys the shared storefront image.
STOREFRONT_PROVISIONER_URL=http://provisioner:8080/storefronts
STOREFRONT_PROVISIONER_TOKEN=
STOREFRONT_IMAGE=ghcr.io/misaf/vendra-storefront-florist:1.x
STOREFRONT_THEMES=default

MAIL_MAILER=smtp
MAIL_PORT=1025
MAIL_FROM_ADDRESS=hello@localhost
MAIL_FROM_NAME="${APP_NAME}"

HORIZON_NOTIFY_MAIL=
