APP_NAME=Vendra
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://localhost
ASSET_URL=https://localhost
TIMEZONE=UTC

ADMIN_DOMAIN=admin.localhost
CONSOLE_DOMAIN=console.localhost
RESELLER_DOMAIN=reseller.localhost

CONSOLE_OPERATOR_USERNAME=vendra
CONSOLE_OPERATOR_EMAIL=hello@localhost
CONSOLE_OPERATOR_PASSWORD=change-this-app-console-operator-password

APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_DATABASE=vendra
DB_USERNAME=vendra
DB_PASSWORD=change-this-app-db-password

REDIS_HOST=127.0.0.1
SESSION_DRIVER=redis
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=null
CACHE_STORE=redis
QUEUE_CONNECTION=redis

FILESYSTEM_DISK=public

SETTINGS_CACHE_ENABLED=true

PULSE_INGEST_DRIVER=redis
PULSE_REDIS_CONNECTION=cache

MAIL_MAILER=smtp
MAIL_PORT=1025
MAIL_FROM_ADDRESS=hello@localhost
MAIL_FROM_NAME="${APP_NAME}"
