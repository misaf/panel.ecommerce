{
    "name": "misaf/vendra-testing",
    "description": "Shared testing utilities for Vendra modules",
    "keywords": [
        "laravel",
        "filamentphp",
        "misaf",
        "vendra",
        "testing"
    ],
    "homepage": "https://github.com/misaf/vendra-testing",
    "license": "MIT",
    "authors": [
        {
            "name": "Ehsan Mahmoodi",
            "email": "misaf.1990@gmail.com",
            "role": "Developer"
        }
    ],
    "type": "vendra-module",
    "require": {
        "php": "^8.4",
        "misaf/vendra-support": "self.version",
        "symfony/finder": "^8.1.1"
    },
    "autoload": {
        "psr-4": {
            "Misaf\\VendraTesting\\": "src/"
        },
        "files": [
            "src/Expectations.php",
            "src/Helpers.php"
        ]
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "support": {
        "issues": "https://github.com/misaf/vendra-testing/issues",
        "source": "https://github.com/misaf/vendra-testing"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "$schema": "https://getcomposer.org/schema.json"
}
