{
    "name": "misaf/vendra-store",
    "description": "Vendra ecommerce Store domain: the concrete tenant model, its domains, and its storefront lifecycle",
    "keywords": [
        "laravel",
        "filamentphp",
        "misaf",
        "vendra",
        "property",
        "storefront"
    ],
    "homepage": "https://github.com/misaf/vendra-store",
    "license": "MIT",
    "authors": [
        {
            "name": "Ehsan Mahmoodi",
            "email": "misaf.1990@gmail.com",
            "role": "Developer"
        }
    ],
    "type": "vendra-module",
    "require": {
        "php": "^8.4",
        "filament/filament": "^5.6.8",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/support": "^13.0",
        "laravel/pennant": "^1.24",
        "misaf/vendra-container": "self.version",
        "misaf/vendra-permission": "self.version",
        "misaf/vendra-subscription": "self.version",
        "misaf/vendra-support": "self.version",
        "misaf/vendra-tenant": "self.version",
        "misaf/vendra-user": "self.version",
        "spatie/laravel-activitylog": "^5.0",
        "spatie/laravel-multitenancy": "^4.1.3",
        "spatie/laravel-package-tools": "^1.93.1",
        "spatie/laravel-settings": "^3.9",
        "spatie/laravel-permission": "^8.0",
        "spatie/laravel-sluggable": "^4.0.2"
    },
    "autoload": {
        "psr-4": {
            "Misaf\\VendraStore\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Misaf\\VendraStore\\Database\\Factories\\": "database/factories/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Misaf\\VendraStore\\Providers\\StoreServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "support": {
        "issues": "https://github.com/misaf/vendra-store/issues",
        "source": "https://github.com/misaf/vendra-store"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "$schema": "https://getcomposer.org/schema.json"
}
