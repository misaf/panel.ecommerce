{
    "name": "misaf/vendra-attribute",
    "description": "Reusable tenant-aware attributes and polymorphic values for Vendra models",
    "keywords": [
        "laravel",
        "filamentphp",
        "misaf",
        "vendra",
        "attribute"
    ],
    "homepage": "https://github.com/misaf/vendra-attribute",
    "license": "MIT",
    "authors": [
        {
            "name": "Ehsan Mahmoodi",
            "email": "misaf.1990@gmail.com",
            "role": "Developer"
        }
    ],
    "type": "vendra-module",
    "require": {
        "php": "^8.4",
        "misaf/vendra-support": "self.version",
        "spatie/eloquent-sortable": "^5.0.1",
        "spatie/laravel-package-tools": "^1.93.1"
    },
    "autoload": {
        "psr-4": {
            "Misaf\\VendraAttribute\\": "src/",
            "Misaf\\VendraAttribute\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Misaf\\VendraAttribute\\Database\\Factories\\": "database/factories/",
            "Misaf\\VendraAttribute\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Misaf\\VendraAttribute\\Providers\\AttributeServiceProvider"
            ]
        }
    },
    "suggest": {
        "misaf/vendra-tagger": "Install this in the host application to assign typed tags to attributes."
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "support": {
        "issues": "https://github.com/misaf/vendra-attribute/issues",
        "source": "https://github.com/misaf/vendra-attribute"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "$schema": "https://getcomposer.org/schema.json"
}
