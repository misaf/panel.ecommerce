{
    "name": "misaf/vendra-phone",
    "description": "International user profile phone numbers for Vendra",
    "keywords": [
        "laravel",
        "filamentphp",
        "misaf",
        "vendra",
        "phone"
    ],
    "homepage": "https://github.com/misaf/vendra-phone",
    "license": "MIT",
    "authors": [
        {
            "name": "Ehsan Mahmoodi",
            "email": "misaf.1990@gmail.com",
            "role": "Developer"
        }
    ],
    "type": "vendra-module",
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.6.8",
        "illuminate/support": "^13.0",
        "misaf/vendra-support": "self.version",
        "misaf/vendra-user-profile": "self.version",
        "spatie/laravel-package-tools": "^1.93.1",
        "ysfkaya/filament-phone-input": "^4.2.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24.1",
        "larastan/larastan": "^3.10.0",
        "laravel/boost": "^2.4.12",
        "laravel/pint": "^1.29.3",
        "misaf/vendra-testing": "self.version",
        "orchestra/testbench": "^11.1",
        "pestphp/pest": "^4.7.5",
        "pestphp/pest-plugin-laravel": "^4.1",
        "phpstan/extension-installer": "^1.4.3"
    },
    "autoload": {
        "psr-4": {
            "Misaf\\VendraPhone\\": "src/",
            "Misaf\\VendraPhone\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Misaf\\VendraPhone\\Database\\Factories\\": "database/factories/",
            "Misaf\\VendraPhone\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Misaf\\VendraPhone\\Providers\\PhoneServiceProvider"
            ]
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "support": {
        "issues": "https://github.com/misaf/vendra-phone/issues",
        "source": "https://github.com/misaf/vendra-phone"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "$schema": "https://getcomposer.org/schema.json"
}
