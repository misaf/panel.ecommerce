{
    "name": "misaf/vendra-faq",
    "description": "Frequently Asked Questions management system with categorization",
    "keywords": [
        "laravel",
        "filamentphp",
        "misaf",
        "vendra",
        "faq"
    ],
    "homepage": "https://github.com/misaf/vendra-faq",
    "license": "MIT",
    "authors": [
        {
            "name": "Ehsan Mahmoodi",
            "email": "misaf.1990@gmail.com",
            "role": "Developer"
        }
    ],
    "type": "vendra-module",
    "require": {
        "php": "^8.4",
        "awcodes/filament-badgeable-column": "^4.0",
        "lara-zeus/spatie-translatable": "^2.0.1",
        "misaf/filament-jalali": "^5.1.4",
        "misaf/vendra-multimedia": "self.version",
        "misaf/vendra-support": "self.version",
        "spatie/eloquent-sortable": "^5.0.1",
        "spatie/laravel-package-tools": "^1.93.1",
        "spatie/laravel-sluggable": "^4.0.2"
    },
    "autoload": {
        "psr-4": {
            "Misaf\\VendraFaq\\": "src/",
            "Misaf\\VendraFaq\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Misaf\\VendraFaq\\Database\\Factories\\": "database/factories/",
            "Misaf\\VendraFaq\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Misaf\\VendraFaq\\Providers\\FaqServiceProvider"
            ]
        }
    },
    "suggest": {
        "misaf/vendra-tagger": "Install this in the host application to assign typed tags to FAQs."
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "support": {
        "issues": "https://github.com/misaf/vendra-faq/issues",
        "source": "https://github.com/misaf/vendra-faq"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "$schema": "https://getcomposer.org/schema.json"
}
