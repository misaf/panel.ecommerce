{
    "name": "misaf/vendra-currency",
    "description": "Currency management with a fiat and crypto catalog, per-tenant activation, and a single default currency",
    "keywords": [
        "laravel",
        "filamentphp",
        "misaf",
        "vendra",
        "currency",
        "money",
        "crypto"
    ],
    "homepage": "https://github.com/misaf/vendra-currency",
    "license": "MIT",
    "authors": [
        {
            "name": "Ehsan Mahmoodi",
            "email": "misaf.1990@gmail.com",
            "role": "Developer"
        }
    ],
    "type": "vendra-module",
    "require": {
        "php": "^8.4",
        "cknow/laravel-money": "^8.5",
        "misaf/filament-jalali": "^5.1.4",
        "misaf/vendra-support": "self.version",
        "moneyphp/crypto-currencies": "^1.1.0",
        "spatie/eloquent-sortable": "^5.0.1",
        "spatie/laravel-package-tools": "^1.93.1"
    },
    "autoload": {
        "psr-4": {
            "Misaf\\VendraCurrency\\": "src/",
            "Misaf\\VendraCurrency\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Misaf\\VendraCurrency\\Database\\Factories\\": "database/factories/",
            "Misaf\\VendraCurrency\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Misaf\\VendraCurrency\\Providers\\CurrencyServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "support": {
        "issues": "https://github.com/misaf/vendra-currency/issues",
        "source": "https://github.com/misaf/vendra-currency"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "$schema": "https://getcomposer.org/schema.json"
}
