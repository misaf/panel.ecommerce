{
    "name": "misaf/vendra-language",
    "description": "Multi-language support system with tenant-aware languages and translation lines",
    "keywords": [
        "laravel",
        "filamentphp",
        "misaf",
        "vendra",
        "multilanguage"
    ],
    "homepage": "https://github.com/misaf/vendra-language",
    "license": "MIT",
    "authors": [
        {
            "name": "Ehsan Mahmoodi",
            "email": "misaf.1990@gmail.com",
            "role": "Developer"
        }
    ],
    "type": "vendra-module",
    "require": {
        "php": "^8.4",
        "bezhansalleh/filament-language-switch": "^5.0",
        "misaf/vendra-support": "self.version",
        "spatie/eloquent-sortable": "^5.0.1",
        "spatie/laravel-package-tools": "^1.93.1",
        "spatie/laravel-translation-loader": "^2.8.3"
    },
    "autoload": {
        "psr-4": {
            "Misaf\\VendraLanguage\\": "src/",
            "Misaf\\VendraLanguage\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Misaf\\VendraLanguage\\Database\\Factories\\": "database/factories/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Misaf\\VendraLanguage\\Providers\\LanguageServiceProvider"
            ]
        }
    },
    "suggest": {
        "misaf/vendra-localization": "Bridges the tenant's enabled languages into request locale resolution (adds a tenant-default resolver and feeds the supported locales)."
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "support": {
        "issues": "https://github.com/misaf/vendra-language/issues",
        "source": "https://github.com/misaf/vendra-language"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "$schema": "https://getcomposer.org/schema.json"
}
