{
    "name": "misaf/vendra-socialite",
    "description": "Optional OAuth social login (Google, GitHub) for Vendra user panels, built on filament-socialite",
    "keywords": [
        "laravel",
        "filamentphp",
        "misaf",
        "vendra",
        "socialite",
        "oauth"
    ],
    "homepage": "https://github.com/misaf/vendra-socialite",
    "license": "MIT",
    "authors": [
        {
            "name": "Ehsan Mahmoodi",
            "email": "misaf.1990@gmail.com",
            "role": "Developer"
        }
    ],
    "type": "vendra-module",
    "require": {
        "php": "^8.4",
        "dutchcodingcompany/filament-socialite": "^3.2",
        "misaf/vendra-support": "self.version",
        "misaf/vendra-user": "self.version",
        "spatie/laravel-package-tools": "^1.93.1"
    },
    "autoload": {
        "psr-4": {
            "Misaf\\VendraSocialite\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Misaf\\VendraSocialite\\Providers\\SocialiteServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "support": {
        "issues": "https://github.com/misaf/vendra-socialite/issues",
        "source": "https://github.com/misaf/vendra-socialite"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "$schema": "https://getcomposer.org/schema.json"
}
